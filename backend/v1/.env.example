# Configuração do Banco de Dados
DB_HOST=localhost
DB_NAME=seu_banco
DB_USER=seu_usuario
DB_PASS=sua_senha

# Configuração de Segurança (JWT)
# Gere uma chave longa e aleatória (mínimo 64 caracteres)
JWT_SECRET=sua_chave_secreta_aqui

# Chave para liberar o acesso ao setup (/setup?key=...)
SETUP_KEY=sua_chave_de_instalacao_aqui

# Ambiente: 'production' (padrão) ou 'dev' (libera CORS localhost)
APP_ENV=production
