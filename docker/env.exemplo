# FOLHA BEM VINDO — modelo do arquivo .env do Docker (na VPS: /opt/bemvindo/.env, permissão 600)
# Copie para .env e troque TODOS os valores. Nunca suba o .env para o git.
# Para gerar valores aleatórios: openssl rand -hex 32

DB_NAME=folha_bemvindo
DB_USER=bemvindo
DB_PASS=troque_por_senha_aleatoria
DB_ROOT_PASS=troque_por_outra_senha_aleatoria

# Mínimo 64 caracteres aleatórios
JWT_SECRET=troque_por_chave_aleatoria_longa
# Libera rotas administrativas (setup, fix_password...) junto com login SUPERADMIN
SETUP_KEY=troque_por_chave_aleatoria

APP_ENV=production
APP_ORIGIN=https://bemvindo.luzitec.cnt.br
APP_PORTA=8090
